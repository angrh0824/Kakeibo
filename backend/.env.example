# ===== アプリケーション設定 =====
APP_NAME="次世代家計簿 API"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# ===== Google account authentication =====
# Keep AUTH_REQUIRED=False for local setup. Enable it in Cloud Run after setting the client ID and allowlist.
AUTH_REQUIRED=False
GOOGLE_OAUTH_CLIENT_ID=""
# Existing family accounts bootstrapped into the legacy family household on first login.
ALLOWED_USER_EMAILS=""
# Platform administrators can approve signups and ban/unban accounts.
PLATFORM_ADMIN_EMAILS=""
LEGACY_HOUSEHOLD_ID="family-main"
LEGACY_HOUSEHOLD_NAME="わが家の家計簿"
ALLOW_SIGNUP_REQUESTS=True

# ===== OpenRouter / LLM 設定 =====
# OpenRouter経由でGemma-4-31b-it等を利用する場合に設定
OPENROUTER_API_KEY=""
DEFAULT_AI_MODEL="google/gemini-2.5-flash-lite"

# ===== Shared family data / receipt image storage =====
FIRESTORE_DATABASE="(default)"
# Receipt image compression / private Cloud Storage
# Set a private Google Cloud Storage bucket name to enable image archiving.
GCS_BUCKET_NAME=""
GCS_RECEIPT_PREFIX="receipts"
GCS_SIGNED_URL_TTL_SECONDS=900
RECEIPT_IMAGE_MAX_UPLOAD_BYTES=15000000
RECEIPT_IMAGE_MAX_BYTES=1500000
RECEIPT_IMAGE_MAX_DIMENSION=1800
RECEIPT_IMAGE_JPEG_QUALITY=82

# ===== Google Cloud Vision OCR (オプション) =====
# Vision APIを利用する場合の認証ファイルパスまたはAPIキー
GOOGLE_APPLICATION_CREDENTIALS=""

# ===== データベース設定 (PostgreSQL 16) =====
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/kakeibo_db"
