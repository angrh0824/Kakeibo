# ===== アプリケーション設定 =====
APP_NAME="次世代家計簿 API"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# ===== OpenRouter / LLM 設定 =====
# OpenRouter経由でGemma-4-31b-it等を利用する場合に設定
OPENROUTER_API_KEY=""
DEFAULT_AI_MODEL="google/gemma-4-31b-it"

# ===== Google Cloud Vision OCR (オプション) =====
# Vision APIを利用する場合の認証ファイルパスまたはAPIキー
GOOGLE_APPLICATION_CREDENTIALS=""

# ===== データベース設定 (PostgreSQL 16) =====
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/kakeibo_db"
